# =============================================================================
# PRODUCTION ENVIRONMENT
# =============================================================================
# File nay chua cac bien moi truong cho production (user cuoi truy cap).
# Cac bien VITE_* se duoc inject vao JS bundle tai build time (PUBLIC, khong dat secret).
# File nay KHONG duoc commit len git (da co trong .gitignore/.dockerignore).
# Trong CI/CD, cac gia tri nay duoc truyen qua GitLab CI Variables (scope: production).
# =============================================================================

# Domain production -- thay bang domain thuc te cua ban
DOMAIN=yourdomain.com

# API endpoint -- dia chi backend API cho production
VITE_API_BASE_URL=https://yourdomain.com/api

# Socket.IO endpoint -- dia chi WebSocket server cho production
VITE_SOCKET_URL=https://yourdomain.com

# App API URL -- tuong tu VITE_API_BASE_URL (dung trong mot so service)
VITE_APP_API_URL=https://yourdomain.com/api

# Stripe public key -- dung LIVE key cho production (pk_live_xxx)
# Day la public key, an toan khi nam trong bundle. KHONG dat secret key o day.
VITE_STRIPE_PUBLIC_KEY=pk_live_your_stripe_live_key

# Xoa console.log tren production -- set true de drop console + debugger
VITE_DROP_CONSOLE=true

# Email cho Certbot (Let's Encrypt SSL) -- dung khi setup HTTPS tren VPS
CERTBOT_EMAIL=your-email@example.com
