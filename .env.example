# === Build-time variables (baked into static files) ===
# Public origin of the SPA (no trailing slash). Required for Open Graph / Twitter image URLs in index.html at build time.
# Set per environment in CI (staging/production). Local dev: http://localhost:3000 (or match VITE_APP_PORT).
VITE_APP_ORIGIN=https://yourdomain.com
VITE_API_BASE_URL=https://api.abc.com
VITE_SOCKET_URL=wss://api.abc.com
VITE_APP_API_URL=https://api.abc.com
VITE_STRIPE_PUBLIC_KEY=pk_test_xxx
VITE_DROP_CONSOLE=false

# === Runtime / Compose variables ===
DOMAIN=abc.com
FE_IMAGE=registry.gitlab.com/your-group/react-vite:latest
