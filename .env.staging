# =============================================================================
# STAGING ENVIRONMENT
# =============================================================================
# File nay chua cac bien moi truong cho staging (test truoc khi release).
# Cac bien VITE_* se duoc inject vao JS bundle tai build time (PUBLIC, khong dat secret).
# File nay KHONG duoc commit len git (da co trong .gitignore/.dockerignore).
# Trong CI/CD, cac gia tri nay duoc truyen qua GitLab CI Variables (scope: staging).
# =============================================================================

# Domain staging -- thay bang domain/subdomain thuc te cua ban
DOMAIN=staging.yourdomain.com

# API endpoint -- dia chi backend API cho moi truong staging
VITE_API_BASE_URL=https://staging.yourdomain.com/api

# Socket.IO endpoint -- dia chi WebSocket server cho staging
VITE_SOCKET_URL=https://staging.yourdomain.com

# App API URL -- tuong tu VITE_API_BASE_URL (dung trong mot so service)
VITE_APP_API_URL=https://staging.yourdomain.com/api

# Stripe public key -- dung TEST key cho staging (pk_test_xxx)
# Day la public key, an toan khi nam trong bundle. KHONG dat secret key o day.
VITE_STRIPE_PUBLIC_KEY=pk_test_your_stripe_test_key

# Giu console.log tren staging de debug -- set false de KHONG xoa console
VITE_DROP_CONSOLE=false
